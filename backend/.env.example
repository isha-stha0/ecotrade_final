# Email Configuration for Scheduled Reports
# These settings are required for the report scheduler to send emails

# Email Service Provider (e.g., 'gmail', 'outlook', 'yahoo')
EMAIL_SERVICE=gmail

# Email address to send reports from
EMAIL_USER=your-email@gmail.com

# Email password or app-specific password
# For Gmail: Use an "App Password" from https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-password

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/ecotrade

# Server Port
PORT=5000

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Cloudinary Configuration
# Get these values from: https://cloudinary.com/console/settings/api-keys
# CLOUDINARY_CLOUD_NAME: Your cloud name
# CLOUDINARY_API_KEY: Your API key
# CLOUDINARY_API_SECRET: Your API secret
# File uploads: Max 5MB, PNG/JPG only
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Note: To enable scheduled reports to send emails:
# 1. Configure the EMAIL_* variables above
# 2. Restart the server
# 3. The report scheduler will automatically load all active scheduled reports on startup
# 4. Scheduled reports will execute at their configured times and send emails to recipients
