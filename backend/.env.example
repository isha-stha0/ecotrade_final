# Email Configuration for scheduled reports and password reset codes
# Without these values, development emails are printed in the backend console.

# Email Service Provider (e.g., 'gmail', 'outlook', 'yahoo')
# SMTP settings (Gmail: use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Email address to send reports from
SMTP_USER=your-email@gmail.com

# Email password or app-specific password
# For Gmail: Use an "App Password" from https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# Optional display address
EMAIL_FROM="EcoTrade Support <your-email@gmail.com>"

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/ecotrade

# Server Port
PORT=5000

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Flutter web URL used by eSewa success/failure redirects
FRONTEND_URL=http://localhost:56115

# eSewa test configuration
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_GATEWAY_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Cloudinary Configuration
# Get these values from: https://cloudinary.com/console/settings/api-keys
# CLOUDINARY_CLOUD_NAME: Your cloud name
# CLOUDINARY_API_KEY: Your API key
# CLOUDINARY_API_SECRET: Your API secret
# File uploads: Max 5MB, PNG/JPG only
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Note: To enable scheduled reports to send emails:
# 1. Configure the EMAIL_* variables above
# 2. Restart the server
# 3. The report scheduler will automatically load all active scheduled reports on startup
# 4. Scheduled reports will execute at their configured times and send emails to recipients
